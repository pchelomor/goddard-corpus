{"quote_id":"FL-CUR-022","corpus_id":"S001","author":"Neville Goddard","source_title":"Five Lessons (Master Class)","source_year":1948,"source_slug":"five_lessons","source_section":"Lesson 5","quote_original":"The desires which impel us to action are those which hold our attention.","primary_topic":"DESIRE","secondary_topics":["ATTENTION"],"tags":["desire","attention","action"],"editorial_decision":"SELECT","review_mode":"SOURCE_FIRST_CANONICAL","source_file":"master_text_five_lessons.txt","review_policy":"EDITORIAL_POLICY.md"}
{"quote_id":"FL-CUR-033","corpus_id":"S001","author":"Neville Goddard","source_title":"Five Lessons (Master Class)","source_year":1948,"source_slug":"five_lessons","source_section":"Lesson 5","quote_original":"When you say you know a thing but you cannot explain it, I say you do not know it, for when you really know it you naturally express it.","primary_topic":"UNDERSTANDING","secondary_topics":["EXPRESSION"],"tags":["understanding","clarity","expression"],"editorial_decision":"SELECT","review_mode":"SOURCE_FIRST_CANONICAL","source_file":"master_text_five_lessons.txt","review_policy":"EDITORIAL_POLICY.md"}
{"quote_id":"FL-CUR-026","corpus_id":"S001","author":"Neville Goddard","source_title":"Five Lessons (Master Class)","source_year":1948,"source_slug":"five_lessons","source_section":"Master class Q&A","quote_original":"It takes an intense hunger to bring about a transformation of self.","primary_topic":"DESIRE","secondary_topics":["SELF_CONCEPT"],"tags":["hunger","transformation","self-concept"],"editorial_decision":"SELECT","review_mode":"SOURCE_FIRST_CANONICAL","source_file":"master_text_five_lessons.txt","review_policy":"EDITORIAL_POLICY.md"}
{"quote_id":"FL-CUR-034","corpus_id":"S001","author":"Neville Goddard","source_title":"Five Lessons (Master Class)","source_year":1948,"source_slug":"five_lessons","source_section":"Master class Q&A","quote_original":"When I speak of feeling I do not mean emotion, but acceptance of the fact that the desire is fulfilled.","primary_topic":"FEELING","secondary_topics":["WISH_FULFILLED"],"tags":["feeling","acceptance","definition"],"editorial_decision":"SELECT","review_mode":"SOURCE_FIRST_CANONICAL","source_file":"master_text_five_lessons.txt","review_policy":"EDITORIAL_POLICY.md"}
